# Public API URL is for browser requests only.
NEXT_PUBLIC_API_BASE_URL=https://YOUR-APP.onrender.com/api/v1

# Server-only authentication
SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters

# Cloudflare R2 (private bucket; do not expose these as NEXT_PUBLIC variables)
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Set only after deploying a trusted scanner worker.
SCAN_WEBHOOK_SECRET=replace-with-a-separate-random-secret-at-least-32-characters
ALLOWED_APP_ORIGINS=https://gameverse-platform-drdc.onrender.com,https://gameverse-admin.onrender.com,https://gameverse-developers.onrender.com
